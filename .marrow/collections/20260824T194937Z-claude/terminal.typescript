ny[162Gfile[167Gis[170Gavailable[180G—[182Gand[186Gthe[190Gmetadata[199Gcost[204Gis[207Ga[209Grounding[218Gerror[224Gagainst[232Gthe[236G35[239GMB[242Gcheckout.[2C[1B[K[2C[1B[1mThe hardlink clone is disqualified for sandboxes[2C[1B[22m[K[2C[1B[38;2;177;185;249mgit clone --local[21G[39mhardlinks[31Gobject[38Gfiles[44Gby[47Gdefault,[56Gwhich[62Gis[65Gwhy[69Git[72Glooks[78Gnearly[85Gfree.[91GBut:[2C[1B[K[2C[1Bhardlinked clone pack:[33G2[37G←[39Gsame[44Ginode[50Gas[53Gyour[58Grepo[2C[1Bcopied[10Gclone[16Gpack:[27Glinks=1[2C[1B[K[2C[1BTha[7G pack file [1mis[22m your arteri[33Gs repos[41Gtory's pack file. Same inode, two names. Git[86Gnever rewrit[99Gs objects[109Gin[112Gplace,[119Gso[122Gnormal[129Guse[133Gis[136Gsafe[141G—[143Gbut[147Ga[149Gcontainer[159Gthat[164Gtruncates[174Gor[177Goverwrites[188Git[191Gcorrupts[200Gyour[205Gactual[212Grepo.[218GFor[222Ga[224Gsandbox[232Gwhose[238Gwhole[244Gpurpose[252Gis[2C[1Bcontainment,[16Ghanding[24Git[27Ga[29Glive[34Ginode[40Ginto[45Gyour[50Ghistory[58Gis[61Gexactly[69Gthe[73Gthing[79Gyou're[86Gtrying[93Gto[96Gprevent.[2C[1B[K[2C[1BSo[6Git's[11Gworktree[20Gat[23G1[25GMB,[29Gor[32Ga[34Gfull[39Gcopy[44Gat[47G24[50GMB.[2C[1B[K[2C[1B[1mWhich means: keep worktrees[2C[1B[22m[K[2C[1BYour[8Gpreference[19Gfor[23Ghistory[31Gis[34Gthe[38Gstrongest[48Gargument[57Gyet[61Gfor[65Gthe[69Gmechanism[79Gyou[83Galready[91Ghave.[97GAnd[101Git[104Gcomposes[113Gwith[118Gthe[122Gread-only-objects[140Gmount:[2C[1B[K[4C[1B[1mFull history[22m for [38;2;177;185;249mgit log[39m, [38;2;177;185;249mgit blame[39m, [38;2;177;185;249mgit di[49Gf HEAD~5[39m — all available to the agent for d[93Gbugging context[4C[1B[1mNo write access[22m — verif[29Ged [33Garlier:[41G[38;2;177;185;249mgit diff[39m/[38;2;177;185;249mstatus[39m/[38;2;177;185;249mlog[61G[3
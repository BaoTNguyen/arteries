@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix art:  <https://arteries.local/ns#> .

art:Claim a owl:Class ; rdfs:label "Claim" .
art:GroundedClaim a owl:Class ; rdfs:label "Grounded Claim" ; rdfs:subClassOf art:Claim .
art:mentions a owl:ObjectProperty ; rdfs:label "mentions" .
